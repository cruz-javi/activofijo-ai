# Servidor interno
PORT=8000
ENV=development
AI_INTERNAL_API_KEY=change_me_internal_ai_secret_key_min_32_chars!
CORE_INTERNAL_URL=http://localhost:3000

# Proveedor LLM local personalizado via Ollama (sin costos ni dependencia externa)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=uagrm-activo-fijo
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024

