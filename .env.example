# Servidor interno
PORT=8000
ENV=development
AI_INTERNAL_API_KEY=change_me_internal_ai_secret_key_min_32_chars!
CORE_INTERNAL_URL=http://localhost:3000

# Proveedor LLM (Groq por defecto; intercambiable por cualquier API compatible OpenAI u Ollama)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOKENS=1024

