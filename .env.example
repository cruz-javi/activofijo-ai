# Servidor interno
PORT=8000
ENV=development
AI_INTERNAL_API_KEY=change_me_internal_ai_secret_key_min_32_chars!
CORE_INTERNAL_URL=http://localhost:3000

# Proveedor LLM local personalizado via Ollama (sin costos ni dependencia externa)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=uagrm-activo-fijo
LLM_TIMEOUT_SECONDS=150
LLM_MAX_TOKENS=1024
LLM_KEEP_ALIVE=25m

# Respaldo remoto opcional (ej. Groq) si el motor local Ollama no está disponible
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_TIMEOUT_SECONDS=25
LLM_FALLBACK_API_KEY=

