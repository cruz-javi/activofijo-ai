PORT=8000
ENV=production
AI_INTERNAL_API_KEY=uagrm_internal_ai_bridge_secret_key_2026_activo_fijo_seguro
CORE_INTERNAL_URL=http://core:3000

# Proveedor LLM principal en producción (Groq directo sin descargar Ollama local)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1024
LLM_KEEP_ALIVE=30m

# Respaldo opcional (si se usa Ollama local en desarrollo)
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_TIMEOUT_SECONDS=25
